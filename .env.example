# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wp_health"

# JWT
JWT_SECRET="your-secret-key-change-this"
JWT_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# Redis
REDIS_URL="redis://localhost:6379"

# App
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Background Jobs
# Set to "true" to use Redis job queue for background processing (recommended for production)
# Set to "false" for in-memory processing (simpler for development)
USE_JOB_QUEUE="false"

# Google Custom Search (for finding businesses)
GOOGLE_API_KEY="your-google-api-key"
GOOGLE_SEARCH_ENGINE_ID="your-search-engine-id"
